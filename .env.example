VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Twitch application Client ID, from https://dev.twitch.tv/console.
# Public by design - it appears in every authorize URL - so shipping it in the bundle is fine.
# The matching Client Secret must NEVER go here; it belongs only in the edge function's secrets.
VITE_TWITCH_CLIENT_ID=your-twitch-client-id
